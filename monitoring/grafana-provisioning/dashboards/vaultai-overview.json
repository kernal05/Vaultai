{
  "title": "VaultAI Overview",
  "uid": "vaultai-overview",
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "title": "Request rate by endpoint",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [{ "expr": "sum(rate(vaultai_http_requests_total[5m])) by (path)", "legendFormat": "{{path}}" }]
    },
    {
      "title": "Error rate (5xx %)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [{ "expr": "100 * sum(rate(vaultai_http_requests_total{status=~\"5..\"}[5m])) / sum(rate(vaultai_http_requests_total[5m]))", "legendFormat": "error %" }]
    },
    {
      "title": "Latency p50 / p95 / p99",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(vaultai_http_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, sum(rate(vaultai_http_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p95" },
        { "expr": "histogram_quantile(0.99, sum(rate(vaultai_http_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p99" }
      ]
    },
    {
      "title": "Anthropic API calls (success vs error)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [{ "expr": "sum(rate(vaultai_anthropic_calls_total[5m])) by (endpoint, status)", "legendFormat": "{{endpoint}} - {{status}}" }]
    },
    {
      "title": "Container memory usage",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [{ "expr": "container_memory_usage_bytes{name=~\"vaultai-.*\"}", "legendFormat": "{{name}}" }]
    },
    {
      "title": "Container CPU usage",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [{ "expr": "rate(container_cpu_usage_seconds_total{name=~\"vaultai-.*\"}[5m])", "legendFormat": "{{name}}" }]
    },
    {
      "title": "API up/down",
      "type": "stat",
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 24 },
      "targets": [{ "expr": "up{job=\"vaultai-api\"}" }],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" } } },
            { "type": "value", "options": { "1": { "text": "UP", "color": "green" } } }
          ]
        }
      }
    }
  ]
}
